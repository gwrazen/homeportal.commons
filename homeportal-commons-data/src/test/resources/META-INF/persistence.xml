<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!-- Jednostka wylacznie na potrzeby testu integracyjnego full-text search:
         baza w pamieci (H2) i indeks Lucene w pamieci (directory provider "ram"). -->
    <persistence-unit name="commons-it" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>pl.homeportal.commons.data.repository.IndexedThing</class>
        <class>pl.homeportal.commons.data.repository.ThingRoot</class>
        <class>pl.homeportal.commons.data.repository.ThingLeaf</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:commons;DB_CLOSE_DELAY=-1"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
            <property name="hibernate.show_sql" value="false"/>
            <!-- Search 6/7: nazwy wlasnosci sa inne niz w 5.x. "ram" nazywa sie dzis
                 "local-heap", a wersji Lucene'a nie podaje sie wcale. -->
            <property name="hibernate.search.backend.directory.type" value="local-heap"/>
        </properties>
    </persistence-unit>
</persistence>
